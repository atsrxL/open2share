<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:icon="@mipmap/open2share_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/open2share_icon_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Open2Share.Material3"
        tools:ignore="GoogleAppIndexingWarning">
        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity-alias
            android:name="unhide_icon"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="hide_icon"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <data
                    android:host="linesoft_abc"
                    android:scheme="top.linesoft.open2share.abc" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ReceiveOpenActivity"
            android:excludeFromRecents="true"
            android:label="@string/label_open2share"
            android:launchMode="singleInstance"
            android:theme="@style/AppTheme.NoDisplay"
            android:exported="true">
            <intent-filter
                android:label="@string/label_open2share"
                tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>


        <activity
            android:name=".WebDavSettingsActivity"
            android:exported="false"
            android:label="@string/webdav_title"
            android:parentActivityName=".SettingsActivity" />

        <!-- Receives files from the system share sheet and uploads them to WebDAV. -->
        <activity
            android:name=".ShareReceiveActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/label_share2nas"
            android:theme="@style/Theme.Open2Share.Material3.Transparent">
            <intent-filter android:label="@string/label_share2nas">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/label_share2nas">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Sits next to open2share in the "open with" list and goes straight to the
                 folder picker, which also avoids the fragile detour through the chooser. -->
            <intent-filter
                android:label="@string/label_share2nas"
                tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".webdav.WebDavUploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>